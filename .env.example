# Copy to .env for local runs. On Railway, set these in the service Variables UI.
# Never commit real tokens or PEM material.

PORT=8787
NODE_ENV=production

# Public URL of this Railway service (no trailing slash). Used for success redirects.
# OOB product origin:
PUBLIC_BASE_URL=https://madeclaw.up.railway.app

# Ledger file. On Railway: mount a volume at /data and keep this path.
BILLING_DB=/data/balance.json

# Shared with MadeClaw plugin serviceToken.
# Constant MADECLAW_DEFAULT_SERVICE_TOKEN — change later in Railway + plugin config.
# If unset, server falls back to this same product default (开箱即用).
BILLING_SERVICE_TOKEN=madeclaw-oob-service-token-v1

# Dev-only free credit via webhook simulatePaid. Leave unset / 0 in production.
BILLING_ALLOW_SIMULATE=0

# Local-only: allow empty SERVICE_TOKEN. Ignored when NODE_ENV=production
# (production always has OOB token fallback above).
# BILLING_REQUIRE_AUTH=0

# Waffo (shared merchant with MadeAPI — ledger stays MadeClaw-only)
# Optional at boot; required only for /pay checkout.
WAFFO_MERCHANT_ID=MER_24yDgYwX9MaPwheVAyCk3d
WAFFO_STORE_ID=STO_1WjWkflwKXm3BodanakF0J
WAFFO_PRODUCT_ID=PROD_3YaLDdlAPjTcANQOcxoo3G
WAFFO_API_BASE=https://api.waffo.ai

# Prefer PEM contents in Railway Variables (multiline OR single-line with \n escapes).
# Accepts -----BEGIN PRIVATE KEY----- (PKCS#8) or -----BEGIN RSA PRIVATE KEY----- (PKCS#1).
# Server unescapes literal \n, strips wrapping quotes, then crypto.createPrivateKey.
# Bad PEM → user sees「支付暂不可用，请检查密钥配置」(details only in Railway logs).
# Example (single-line — paste full PEM; do not truncate):
# WAFFO_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
# Or paste the full multiline PEM block into the Railway variable UI.
# Local-dev fallback path (do not commit real PEM):
WAFFO_PRIVATE_KEY_PATH=./secrets/waffo-private.pem

# Required in production. Send as Authorization: Bearer <secret> or X-Webhook-Secret.
WAFFO_WEBHOOK_SECRET=change-me-webhook-secret

# Optional: override GitHub Release download URLs (defaults in src/defaults.js)
# DOWNLOAD_MACOS_URL=https://github.com/coderwar021/madeclaw/releases/download/v2026.8.1/MadeClaw-macOS-2026.8.1.dmg
# DOWNLOAD_WINDOWS_X64_URL=https://github.com/coderwar021/madeclaw/releases/download/v2026.8.1/MadeClaw-Windows-x64-Setup.exe
# DOWNLOAD_WINDOWS_ARM64_URL=https://github.com/coderwar021/madeclaw/releases/download/v2026.8.1/MadeClaw-Windows-arm64-Setup.exe

# Optional override (defaults to ${PUBLIC_BASE_URL}/pay/success)
# PAY_SUCCESS_URL=https://madeclaw.up.railway.app/pay/success
